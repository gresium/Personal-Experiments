{
  "log_dir": null,
  "log_basename": "honeypot.log",
  "alert_basename": "alerts.log",
  "log_max_bytes": 5242880,
  "log_backups": 5,
  "state_dir": null,
  "token_store": null,
  "decoy_dir": null,
  "webhook_url": null,
  "webhook_min_interval": 5,
  "max_connections": 200,
  "conn_timeout": 20,
  "conn_lifetime": 120,
  "max_line_bytes": 4096,
  "max_conn_bytes": 16384,
  "drop_privileges_to": null,

  "_comment": "Edit the services list to choose which fake services run and on which ports. Ports below 1024 need admin/root to bind; a service whose port can't be bound is reported and skipped, and the rest still run. mode is one of: login, http, banner, ftp, smtp, dns, https, smb, rdp, mysql, postgres, redis, mongodb, vnc, ldap, nfs. Set tls_cert and tls_key on the https service to serve a real TLS page. Set webhook_url to POST a JSON alert whenever a honeytoken is used (Slack/Teams/SIEM/etc). state_dir holds tokens.json and the decoys/ folder; manage tokens with honeytokens.py.",

  "services": [
    {
      "name": "ssh",
      "bind": "0.0.0.0",
      "port": 2222,
      "mode": "login",
      "banner": "SSH-2.0-OpenSSH_8.2p1 Ubuntu-4ubuntu0.5",
      "ssh_auth_delay": 2,
      "max_auth_tries": 6,
      "user_prompt": "login: ",
      "pass_prompt": "Password: ",
      "deny": "\r\nPermission denied, please try again.\r\n",
      "login_rounds": 3
    },
    {
      "name": "telnet",
      "bind": "0.0.0.0",
      "port": 2323,
      "mode": "login",
      "banner": "\r\nUbuntu 22.04.3 LTS\r\n",
      "user_prompt": "login: ",
      "pass_prompt": "Password: ",
      "deny": "\r\nLogin incorrect\r\n",
      "login_rounds": 3
    },
    {
      "name": "http",
      "bind": "0.0.0.0",
      "port": 8080,
      "mode": "http"
    },
    { "name": "ftp", "bind": "0.0.0.0", "port": 21, "mode": "ftp", "banner": "220 (vsFTPd 3.0.5)\r\n" },
    { "name": "smtp", "bind": "0.0.0.0", "port": 25, "mode": "smtp", "hostname": "mail01.corp.local", "banner": "220 mail01.corp.local ESMTP Postfix (Ubuntu)\r\n" },
    { "name": "dns", "bind": "0.0.0.0", "port": 53, "mode": "dns", "version": "9.18.28-0ubuntu0.22.04.1-Ubuntu" },
    { "name": "http-80", "bind": "0.0.0.0", "port": 80, "mode": "http", "server": "Apache/2.4.52 (Ubuntu)" },
    { "name": "https", "bind": "0.0.0.0", "port": 443, "mode": "https", "server": "nginx/1.18.0 (Ubuntu)", "tls_cert": null, "tls_key": null },
    { "name": "smb", "bind": "0.0.0.0", "port": 445, "mode": "smb", "domain": "CORP", "computer": "FILESRV01" },
    { "name": "rdp", "bind": "0.0.0.0", "port": 3389, "mode": "rdp" },
    { "name": "mysql", "bind": "0.0.0.0", "port": 3306, "mode": "mysql", "version": "8.0.39-0ubuntu0.22.04.1" },
    { "name": "postgres", "bind": "0.0.0.0", "port": 5432, "mode": "postgres" },
    { "name": "redis", "bind": "0.0.0.0", "port": 6379, "mode": "redis" },
    { "name": "mongodb", "bind": "0.0.0.0", "port": 27017, "mode": "mongodb", "version": "7.0.14" },
    { "name": "elasticsearch", "bind": "0.0.0.0", "port": 9200, "mode": "http", "profile": "elasticsearch" },
    { "name": "vnc", "bind": "0.0.0.0", "port": 5900, "mode": "vnc", "banner": "RFB 003.008\n" },
    { "name": "ldap", "bind": "0.0.0.0", "port": 389, "mode": "ldap", "naming_context": "dc=corp,dc=local" },
    { "name": "nfs", "bind": "0.0.0.0", "port": 2049, "mode": "nfs" }
  ]
}
