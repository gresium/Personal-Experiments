{
  "log_dir": null,
  "log_basename": "honeypot.log",
  "alert_basename": "alerts.log",
  "log_max_bytes": 5242880,
  "log_backups": 5,
  "state_dir": null,
  "token_store": null,
  "decoy_dir": null,
  "webhook_url": null,
  "webhook_min_interval": 5,
  "max_connections": 200,
  "conn_timeout": 20,
  "max_line_bytes": 4096,
  "max_conn_bytes": 16384,
  "drop_privileges_to": null,

  "_comment": "Edit the services list to choose which fake services run and on which ports. Ports below 1024 need admin/root to bind; the defaults are high ports so no privileges are required. mode is one of: login, http, banner. Set webhook_url to POST a JSON alert whenever a honeytoken is used (Slack/Teams/SIEM/etc). state_dir holds tokens.json and the decoys/ folder; manage tokens with honeytokens.py.",

  "services": [
    {
      "name": "ssh",
      "bind": "0.0.0.0",
      "port": 2222,
      "mode": "login",
      "banner": "SSH-2.0-OpenSSH_8.2p1 Ubuntu-4ubuntu0.5",
      "user_prompt": "login: ",
      "pass_prompt": "Password: ",
      "deny": "\r\nPermission denied, please try again.\r\n",
      "login_rounds": 3
    },
    {
      "name": "telnet",
      "bind": "0.0.0.0",
      "port": 2323,
      "mode": "login",
      "banner": "\r\nUbuntu 22.04.3 LTS\r\n",
      "user_prompt": "login: ",
      "pass_prompt": "Password: ",
      "deny": "\r\nLogin incorrect\r\n",
      "login_rounds": 3
    },
    {
      "name": "http",
      "bind": "0.0.0.0",
      "port": 8080,
      "mode": "http"
    }
  ]
}
